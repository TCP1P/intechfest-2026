[Unit]
Description=Minions in 16k authoritative server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StateDirectory=minions-in-16k
ConfigurationDirectory=minions-in-16k
WorkingDirectory=/var/lib/minions-in-16k
ReadWritePaths=/var/lib/minions-in-16k/replays
ExecStart=/usr/local/bin/minions-server --bind 0.0.0.0:4433 --replay-dir /var/lib/minions-in-16k/replays --feature-flags /etc/minions-in-16k/feature_flags.toml
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
