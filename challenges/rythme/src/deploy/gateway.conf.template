server {
    listen 8080;
    server_name _;
    client_max_body_size 1m;

    location ~ "^/api/v1/beatmaps/(?<beatmap>[a-z0-9][a-z0-9-]{0,127}\.osz)$" {
        alias /srv/beatmaps/$beatmap;
        default_type application/x-osu-beatmap-archive;
        log_not_found off;
        limit_except GET { deny all; }
        add_header Content-Disposition 'attachment; filename="$beatmap"' always;
        add_header Cache-Control 'public, max-age=86400, immutable' always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }

    location /api/v1/beatmaps/ {
        return 404;
    }

    # Finalized evidence is private to the observer network.
    location = /api/v1/scoring {
        return 404;
    }

    # Only the coordinator network may exchange an opaque player capability.
    location = /api/v1/koth/capability/authenticate {
        allow ${RYTHME_BACKEND_SUBNET};
        deny all;

        resolver 127.0.0.11 valid=5s ipv6=off;
        set $rsctf_web http://rsctf:8080;
        proxy_pass $rsctf_web;
        proxy_http_version 1.1;
        proxy_set_header Host ${RSCTF_PUBLIC_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;
        proxy_send_timeout 8s;
    }

    location / {
        proxy_pass http://coordinator:1337;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 30s;
    }
}
