# One .gzevent owns only the challenge manifests below this directory.
title: "INTECHFEST 2026 Warmup"
hidden: true
summary: "Warmup challenges for INTECHFEST 2026."
content: |
  This event is imported from the warmup tree in the private INTECHFEST 2026
  challenge repository. It contains a self-hosted Attack & Defense service,
  a marker King of the Hill, and a managed Leaderboard scoring game. Keep it
  hidden until its schedule, player delivery, engine setup, and challenge set
  have passed release review.

acceptWithoutReview: false
practiceMode: true
writeupRequired: false
writeupNote: "No writeup is required for the warmup event."

# Current Repository Bindings releases do not import KotH crown-cycle settings from
# `.gzevent`. Before enabling any warmup hill, the operator must set epoch=12,
# cycle=6, champion cooldown=1, and claim confirmation=2 in Admin event settings.
# Draft Control's target becomes player-visible only after readiness; the platform
# default cycle=3 does not leave enough ticks to confirm and score a new marker.
ad:
  # Leaderboard evidence has a 20-second settlement lag. Contiguous 60-second
  # settlement windows each own one completed UTC-minute Serpent wave; the
  # initial partial wave is deliberately left unscored.
  tickSeconds: 60
  flagLifetimeTicks: 5
  warmupSeconds: 120
  resetCooldownMinutes: 5
  allowSnapshotDownload: false
