FROM python:3.12-alpine@sha256:d09d15e60962ca365d1cd544a48773bac9d33f2fb1b00f2aa0deec78ade7dc31

RUN addgroup -S parcel \
    && adduser -S -D -H -G parcel parcel \
    && mkdir -p /app /srv/parcels /run/rsctf

WORKDIR /app
COPY --chown=root:root app.py /app/app.py
COPY --chown=root:root parcels/ /srv/parcels/

# The generated BYOC Compose file overrides this with /shared/flag, which is
# atomically maintained by the relay agent. The fallback keeps the image's
# standalone runtime contract explicit without baking a flag into the layer.
ENV PARCEL_ROOT=/srv/parcels \
    RSCTF_FLAG_FILE=/run/rsctf/flag \
    PORT=8080

USER parcel
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=2s --retries=3 \
  CMD ["python", "-c", "import sys,urllib.request; sys.exit(urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=2).read()!=b'ok\\n')"]
CMD ["python", "-u", "/app/app.py"]
