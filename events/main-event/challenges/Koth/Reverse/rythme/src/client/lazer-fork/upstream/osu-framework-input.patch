+        /// <summary>
+        /// A mouse press can begin outside the window, leaving the current
+        /// state pressed without a button-down input queue. Moving back into
+        /// the window must not crash and the next normal drag must still work.
+        /// </summary>
+        [Test]
+        public void TestDragWithoutButtonDownQueueDoesNotCrash()
+        {
+            InputReceptor receptor = null;
+            Vector2 start = Vector2.Zero;
+
+            AddStep("create receptor", () =>
+            {
+                Child = receptor = new InputReceptor { Size = new Vector2(300) };
+            });
+            AddStep("move mouse to receptor", () =>
+            {
+                start = receptor.ToScreenSpace(receptor.LayoutRectangle.Centre);
+                InputManager.MoveMouseTo(start);
+            });
+            AddStep("press button", () => InputManager.PressButton(MouseButton.Left));
+            AddStep("lose button-down queue", () =>
+            {
+                MouseButtonEventManager manager = InputManager.GetButtonEventManagerFor(MouseButton.Left);
+                PropertyInfo queue = typeof(ButtonEventManager<MouseButton>).GetProperty(
+                    "ButtonDownInputQueue",
+                    BindingFlags.Instance | BindingFlags.NonPublic);
+                Assert.That(queue, Is.Not.Null);
+                queue.SetValue(manager, null);
+            });
+            AddStep("move orphaned press", () => InputManager.MoveMouseTo(start + new Vector2(30)));
+            AddAssert("orphaned press did not drag", () => !receptor.DragStartReceived);
+            AddStep("release orphaned press", () => InputManager.ReleaseButton(MouseButton.Left));
+
+            AddStep("press normally", () => InputManager.PressButton(MouseButton.Left));
+            AddStep("drag normally", () => InputManager.MoveMouseTo(start + new Vector2(60)));
+            AddAssert("next normal drag works", () => receptor.DragStartReceived);
+            AddStep("release normal drag", () => InputManager.ReleaseButton(MouseButton.Left));
+        }
+
         private partial class InputReceptor : Box
         {
             public bool ClickReceived { get; set; }
diff --git a/osu.Framework/Input/KeyEventManager.cs b/osu.Framework/Input/KeyEventManager.cs
index d1434a3bf..56529b20b 100644
--- a/osu.Framework/Input/KeyEventManager.cs
+++ b/osu.Framework/Input/KeyEventManager.cs
@@ -23,6 +23,12 @@ namespace osu.Framework.Input
 
         public void HandleRepeat(InputState state)
         {
+            // A repeat can be forwarded after the originating key-down was
+            // missed by this input manager. Without a down queue there are no
+            // valid recipients for the repeat.
+            if (ButtonDownInputQueue == null)
+                return;
+
             // Only drawables that can still handle input should handle the repeat
             var drawables = ButtonDownInputQueue.AsNonNull().Intersect(InputQueue);
 
diff --git a/osu.Framework/Input/TouchEventManager.cs b/osu.Framework/Input/TouchEventManager.cs
index 97ff95a1f..315cedc8e 100644
--- a/osu.Framework/Input/TouchEventManager.cs
+++ b/osu.Framework/Input/TouchEventManager.cs
@@ -37,6 +37,11 @@ namespace osu.Framework.Input
 
         private void handleTouchMove(InputState state, Vector2 position, Vector2 lastPosition)
         {
+            // Touch movement may reach an input manager without the matching
+            // touch-down (for example after focus or pass-through changes).
+            if (ButtonDownInputQueue == null)
+                return;
+
             PropagateButtonEvent(ButtonDownInputQueue!.Where(d => d.IsRootedAt(InputManager)), new TouchMoveEvent(state, new Touch(Button, position), TouchDownPosition, lastPosition));
         }
 
